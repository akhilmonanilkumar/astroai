{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "landing",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "landing", "run", "dev"],
      "port": 3000
    },
    {
      "name": "simulator",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["--directory", "backend", "run", "python", "-m", "guruji", "dev"],
      "env": { "REDIS_URL": "memory://", "PYTHONIOENCODING": "utf-8" },
      "port": 8100
    }
  ]
}
