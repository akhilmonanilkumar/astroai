# Copy to backend/.env for local runs. Never commit .env.
ENV=dev
LOG_LEVEL=INFO

# memory:// = in-process fake Redis (single-process `dev` role only)
REDIS_URL=redis://localhost:6379/0

BIND_HOST=127.0.0.1
INGRESS_PORT=8000
SIMULATOR_PORT=8100

# WhatsApp Cloud API. Dev values below work with the simulator.
WA_VERIFY_TOKEN=dev-verify-token
WA_APP_SECRET=dev-app-secret
WA_ACCESS_TOKEN=dev-access-token
WA_PHONE_NUMBER_ID=1000000001
# Simulator in dev; https://graph.facebook.com in staging/prod
GRAPH_API_BASE=http://127.0.0.1:8100
GRAPH_API_VERSION=v23.0

SIMULATOR_INGRESS_URL=http://127.0.0.1:8000/webhook

# Data files (download once):
#   uv run python -m guruji fetch-ephemeris && uv run python -m guruji fetch-geonames
EPHEMERIS_PATH=data/ephemeris/de440s.bsp
GEONAMES_DIR=data/geonames
# Local embedding model for rule-card search: uv run python -m guruji fetch-models
MODELS_DIR=data/models

# Postgres (Supabase pooler URL in staging/prod). memory:// = in-process store, dev only.
DATABASE_URL=memory://
DB_POOL_MAX=5

# Personal-data encryption: 32 random bytes each, base64. Dev defaults are refused in prod.
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# FIELD_ENCRYPTION_KEY=
# LOOKUP_HMAC_KEY=

# LLMs ("provider:model"). Sarvam by default; "anthropic:<model>" also works.
# Without the provider's key, dev falls back to a scripted fake model.
# GURU_MODEL does real work (readings, timing, remedies); TALK_MODEL handles conversation;
# FAST_MODEL routes turns between them and extracts onboarding answers.
# SARVAM_API_KEY=
# `uv run python -m guruji models` lists the ids Sarvam serves; compare models with
# `uv run python -m guruji eval --models A,B --judge C`.
GURU_MODEL=sarvam:sarvam-105b
GURU_FALLBACK_MODEL=sarvam:sarvam-105b-conversations
TALK_MODEL=sarvam:sarvam-105b-conversations
FAST_MODEL=sarvam:sarvam-105b-conversations
# Thinking for sarvam-105b: none|low|high|max. "low" still thinks 30+ s per reading.
REASONING_EFFORT=none
# ANTHROPIC_API_KEY=

# Voice notes (Sarvam speech-to-text / text-to-speech, same SARVAM_API_KEY)
VOICE_ENABLED=true
TTS_SPEAKER=aditya

# Escalation alerts to the team (Telegram). Unset in dev: alerts go to the log.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Set the same value as secret_token when registering the bot webhook
# (https://<ingress>/telegram/webhook) so button taps can acknowledge alerts.
# TELEGRAM_WEBHOOK_SECRET=
ADMIN_CONSOLE_URL=https://admin.guruji.example
ALERT_REPEAT_SECONDS=300

# Admin console API (`admin` role). dev: sign in as dev:<email> (refused in staging/prod).
# supabase: Supabase Auth tokens with MFA; keys from SUPABASE_URL's JWKS, or set the legacy
# SUPABASE_JWT_SECRET if the project still signs with HS256.
ADMIN_AUTH=dev
ADMIN_PORT=8200
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_JWT_SECRET=

# Payments (Razorpay). Unset in dev: the simulator plays Razorpay.
# PAYMENT_CHECKOUT=link: a Razorpay payment link behind a "Pay" button. Works with test
#   keys (rzp_test_...) before company KYC and without a WhatsApp payment configuration.
# PAYMENT_CHECKOUT=whatsapp: WhatsApp's native checkout; needs WA_PAYMENT_CONFIG, the
#   payment configuration linked in WhatsApp Manager (verified business + Razorpay KYC).
# The Razorpay webhook goes to https://<ingress>/razorpay/webhook (events payment_link.paid,
# order.paid, payment.captured); without it, payments are still found by polling.
# PAYMENT_CHECKOUT=link
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_API_BASE=https://api.razorpay.com
# WA_PAYMENT_CONFIG=

# Meta Conversions API for Click-to-WhatsApp ads (Lead, Purchase). Unset: skipped.
# CAPI_DATASET_ID=
# CAPI_ACCESS_TOKEN=
# WA_BUSINESS_ACCOUNT_ID=

PRIVACY_NOTICE_URL=https://guruji.example/privacy
NOTICE_VERSION=2026-09-v1
