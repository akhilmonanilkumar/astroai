# Backend admin API (python -m guruji admin, or dev). Read at runtime by the /api proxy.
ADMIN_API_URL=http://127.0.0.1:8200

# Supabase Auth for team sign-in (email + password, then TOTP). Leave both empty in dev to
# sign in as dev:<email> against a backend running with ADMIN_AUTH=dev.
SUPABASE_URL=
SUPABASE_ANON_KEY=
